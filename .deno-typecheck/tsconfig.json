{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "npm:@anthropic-ai/sdk@1.3.0": [
        "node_modules/@anthropic-ai/sdk"
      ],
      "npm:@anthropic-ai/sdk@1.3.0/helpers/zod": [
        "node_modules/@anthropic-ai/sdk/helpers/zod"
      ],
      "npm:@supabase/supabase-js@2.118.0": [
        "node_modules/@supabase/supabase-js"
      ],
      "npm:zod@4.6.7": [
        "node_modules/zod"
      ]
    }
  },
  "include": [
    "deno-shim.d.ts",
    "stripe-shim.d.ts",
    "../supabase/functions/**/*.ts"
  ]
}