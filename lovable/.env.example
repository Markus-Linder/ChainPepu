# Lovable trägt diese Werte beim Verbinden mit Supabase automatisch ein.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=DEIN-ANON-KEY
# Optional: Push-Mitteilungen. Öffentlicher VAPID-Schlüssel (npx web-push generate-vapid-keys), privater Schlüssel als Supabase-Secret.
VITE_VAPID_PUBLIC_KEY=
