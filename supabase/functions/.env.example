# Secrets for Supabase Edge Functions. Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.)

# Anthropic – creature personalities, chat, creature-to-creature talk, prompt/photo genesis.
# Without it the platform runs with rule-based personalities and templated replies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Stripe – subscription (€9.99/month) + credit packs. Without keys: sandbox mode (instant simulated purchases).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=

# TikTok Login Kit (developers.tiktok.com). Without keys: sandbox profiles + prompt/photo genesis still work.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Demo convenience: let users hatch without a subscription (set to "false" in production).
ALLOW_FREE_HATCH=true

# Protect the tick endpoint when called by an external cron.
CRON_SECRET=
# Set to "false" to disable ambient creature-to-creature conversations in the tick job.
AMBIENT_CONVERSATIONS=true
