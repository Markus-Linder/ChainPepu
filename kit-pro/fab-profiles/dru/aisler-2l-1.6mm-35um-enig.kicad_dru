# KiCad custom design rules - AISLER - 2 Layer 1.6 mm 35 um ENIG
# Fab: AISLER (aisler)   Process id: 2l-1.6mm-35um-enig
# Source: https://community.aisler.net/t/2-layer-1-6mm-35-m-enig-design-rules/3732
# Retrieved: 2026-10-23   Generated from kit-pro/fab-profiles/aisler.json (schema_version 1)
# Values are the fab's published MINIMUMS. Add margin. Constraints whose value is null in the JSON are omitted.
# Usage: Board Setup > Design Rules > Custom Rules (paste), or copy next to your project as <project>.kicad_dru
(version 1)
(rule "aisler min track width"
  (constraint track_width (min 0.125mm)))
(rule "aisler min copper clearance"
  (constraint clearance (min 0.125mm)))
(rule "aisler min via drill/diameter"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.25mm)))
(rule "aisler min PTH drill"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_size (min 0.5mm)))
(rule "aisler min NPTH drill"
  (condition "A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm)))
# Larger holes are routed/milled by the fab; check the JSON notes
(rule "aisler max drilled hole"
  (constraint hole_size (max 5.6mm)))
(rule "aisler min via annular ring"
  (condition "A.Type == 'Via'")
  (constraint annular_width (min 0.1mm)))
# PTH annular ring 300 um
(rule "aisler min PTH pad annular ring"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.3mm)))
(rule "aisler min hole to hole"
  (constraint hole_to_hole (min 0.3mm)))
# Only NPTH-to-copper is published by this fab
(rule "aisler min NPTH hole to copper"
  (condition "A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.25mm)))
# Routed edge value; V-cut edges need more (see JSON notes)
(rule "aisler min copper to board edge"
  (constraint edge_clearance (min 0.3mm)))
(rule "aisler min silkscreen to pad/copper clearance"
  (constraint silk_clearance (min 0.125mm)))
(rule "aisler min silkscreen text"
  (condition "A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen'")
  (constraint text_thickness (min 0.15mm))
  (constraint text_height (min 0.8mm)))
# Solder mask minimum web 0.1mm is not a custom-rule constraint: set it in Board Setup > Board Stackup > Solder Mask/Paste > 'Solder mask minimum web width'.
# Minimum slot width 0.7mm (plated) has no KiCad constraint; check oval holes manually.
