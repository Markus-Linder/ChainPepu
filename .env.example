# Frontend (Vite) – Lovable sets these automatically when you connect Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-KEY

# Edge function secrets (set with `supabase secrets set` or in Lovable → Supabase → Secrets)
# ANTHROPIC_API_KEY=sk-ant-...
# JUDGE_MODEL=claude-opus-5-5
