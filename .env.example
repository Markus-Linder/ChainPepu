# ---- MetaApi (https://app.metaapi.cloud) ----
# API-Token: MetaApi-App -> Profil -> "API access token" (Rolle: reader reicht für Monitoring)
METAAPI_TOKEN=
# Account-ID des MT5-Kontos, das du in der MetaApi-App hinzugefügt hast
METAAPI_ACCOUNT_ID=
# Region, in der das Konto liegt (steht in der MetaApi-App beim Konto), z. B. london, new-york, singapore
METAAPI_REGION=london

# ---- Telegram ----
# Bot-Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Komma-getrennte Chat-IDs, die den Bot benutzen dürfen. Leer = niemand (der Bot nennt dir deine ID).
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Verhalten ----
# Wie oft (Sekunden) das Konto auf neue/geschlossene Positionen geprüft wird
POLL_INTERVAL_SECONDS=20
# Drawdown-Alarm in Prozent (Equity unter Balance). 0 = aus
DRAWDOWN_ALERT_PERCENT=5
# Uhrzeit des Tagesberichts (Stunde, 0-23) in der Zeitzone TZ
DAILY_REPORT_HOUR=22
TZ=Europe/Berlin
