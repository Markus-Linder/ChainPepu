# Geheimer Schlüssel für Sitzungs-Cookies (beliebige lange Zeichenkette)
SESSION_SECRET=bitte-aendern-langer-zufaelliger-schluessel
# Pfad zur SQLite-Datei (Standard: ./data/chainpepu.db)
DATABASE_PATH=./data/chainpepu.db
# Öffentliche URL der App (für Einladungslinks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Stripe für echte Sterne-Käufe. Ohne Schlüssel läuft der Shop im Demo-Modus.
STRIPE_SECRET_KEY=
